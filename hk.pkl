amends "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Config.pkl"

hooks {
    ["pre-commit"] {
        fix = false
        steps {
            ["rumdl"] {
                glob = List(
                    "*.md",
                    "**/*.md",
                    "*.mdx",
                    "**/*.mdx",
                )
                check = "mise exec -- rumdl check {{files}}"
                fix = "mise exec -- rumdl fmt {{files}}"
            }
            ["typos"] {
                check = "mise exec -- typos --force-exclude {{files}}"
                fix = "mise exec -- typos --force-exclude --write-changes {{files}}"
            }
            ["check-gitattributes"] {
                check = "mise run gitattributes-check"
                fix = "mise run gitattributes-generate && mise run gitattributes-check"
                exclusive = true
            }
            ["check-wiki"] {
                check = "mise run wiki-check"
                fix = "mise run wiki-check"
                exclusive = true
            }
        }
    }
    ["check"] {
        fix = false
        steps {
            ["rumdl"] {
                glob = List(
                    "*.md",
                    "**/*.md",
                    "*.mdx",
                    "**/*.mdx",
                )
                check = "mise exec -- rumdl check {{files}}"
                fix = "mise exec -- rumdl fmt {{files}}"
            }
            ["typos"] {
                check = "mise exec -- typos --force-exclude {{files}}"
                fix = "mise exec -- typos --force-exclude --write-changes {{files}}"
            }
            ["check-gitattributes"] {
                check = "mise run gitattributes-check"
                fix = "mise run gitattributes-generate && mise run gitattributes-check"
                exclusive = true
            }
            ["check-wiki"] {
                check = "mise run wiki-check"
                fix = "mise run wiki-check"
                exclusive = true
            }
        }
    }
    ["fix"] {
        fix = true
        steps {
            ["rumdl"] {
                glob = List(
                    "*.md",
                    "**/*.md",
                    "*.mdx",
                    "**/*.mdx",
                )
                check = "mise exec -- rumdl check {{files}}"
                fix = "mise exec -- rumdl fmt {{files}}"
            }
            ["typos"] {
                check = "mise exec -- typos --force-exclude {{files}}"
                fix = "mise exec -- typos --force-exclude --write-changes {{files}}"
            }
            ["check-gitattributes"] {
                check = "mise run gitattributes-check"
                fix = "mise run gitattributes-generate && mise run gitattributes-check"
                exclusive = true
            }
            ["check-wiki"] {
                check = "mise run wiki-check"
                fix = "mise run wiki-check"
                exclusive = true
            }
        }
    }
}
